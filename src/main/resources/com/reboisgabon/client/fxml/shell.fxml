<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="768.0"
        prefWidth="1280.0"
        stylesheets="@../theme/theme.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.reboisgabon.client.controllers.ShellController">

    <left>

        <VBox
                fx:id="sidebar"
                prefWidth="240.0"
                minWidth="72.0"
                maxWidth="240.0"
                styleClass="sidebar"
                BorderPane.alignment="CENTER">

            <children>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="10.0">

                    <padding>
                        <Insets
                                top="20.0"
                                right="15.0"
                                bottom="20.0"
                                left="15.0"/>
                    </padding>

                    <children>

                        <Button
                                fx:id="toggleSidebarBtn"
                                onAction="#handleToggleSidebar"
                                styleClass="icon-button"
                                text="☰"/>

                        <Label
                                fx:id="logoLabel"
                                styleClass="text-header-title"
                                text="ReboisGabon"/>

                    </children>

                </HBox>


                <VBox
                        spacing="5.0"
                        VBox.vgrow="ALWAYS">

                    <padding>
                        <Insets
                                left="10.0"
                                right="10.0"/>
                    </padding>

                    <children>

                        <Button
                                fx:id="boutonDashboard"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerDashboard"
                                styleClass="nav-button"
                                text="📊  Dashboard"/>

                        <Button
                                fx:id="boutonSites"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerSites"
                                styleClass="nav-button"
                                text="📍  Sites"/>

                        <Button
                                fx:id="boutonCampagnes"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerCampagnes"
                                styleClass="nav-button"
                                text="🌱  Campagnes"/>

                        <Button
                                fx:id="boutonSuivis"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerSuivis"
                                styleClass="nav-button"
                                text="📈  Suivis"/>

                        <Button
                                fx:id="boutonEssences"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerEssences"
                                styleClass="nav-button"
                                text="🌳  Essences"/>

                        <Button
                                fx:id="boutonObjectifs"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerObjectifs"
                                styleClass="nav-button"
                                text="🎯  Objectifs"/>

                        <Button
                                fx:id="boutonFinances"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerFinances"
                                styleClass="nav-button"
                                text="💰  Finances"/>

                        <Button
                                fx:id="boutonIntelligence"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerIntelligence"
                                styleClass="nav-button"
                                text="🤖  IA Ecologique"/>

                        <Button
                                fx:id="boutonUtilisateurs"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerUtilisateurs"
                                styleClass="nav-button"
                                text="👥  Utilisateurs"/>

                        <Button
                                fx:id="boutonJournal"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerJournal"
                                styleClass="nav-button"
                                text="📜  Journal"/>
                        <Button
                                fx:id="boutonExports"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerExports"
                                styleClass="nav-button"
                                text="📤  Exports"/>

                        <Button
                                fx:id="boutonParametres"
                                maxWidth="1.7976931348623157E308"
                                onAction="#allerParametres"
                                styleClass="nav-button"
                                text="⚙️  Paramètres"/>

                    </children>

                </VBox>


                <VBox
                        spacing="10.0">

                    <padding>
                        <Insets
                                top="10.0"
                                right="10.0"
                                bottom="20.0"
                                left="10.0"/>
                    </padding>

                    <children>

                        <Button
                                maxWidth="1.7976931348623157E308"
                                onAction="#seDeconnecter"
                                styleClass="nav-button, logout-button"
                                text="🚪  Déconnexion"/>

                    </children>

                </VBox>

            </children>

        </VBox>

    </left>


    <center>

        <BorderPane>

            <top>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="20.0"
                        styleClass="content-header">

                    <padding>
                        <Insets
                                top="20.0"
                                right="25.0"
                                bottom="20.0"
                                left="25.0"/>
                    </padding>

                    <children>

                        <Label
                                fx:id="libelleTitreEcran"
                                styleClass="screen-title"
                                text="Tableau de bord"/>

                        <HBox
                                alignment="CENTER_RIGHT"
                                spacing="10.0"
                                HBox.hgrow="ALWAYS">

                            <children>

                                <Button
                                        onAction="#allerNotifications"
                                        styleClass="icon-button"
                                        text="🔔"/>

                                <Label
                                        fx:id="badgeNotifications"
                                        styleClass="notification-badge"
                                        text="0"
                                        visible="false"
                                        managed="false"/>

                                <VBox
                                        spacing="2.0">

                                    <children>

                                        <Label
                                                fx:id="libelleNomUtilisateur"
                                                styleClass="user-name"
                                                text="Utilisateur"/>

                                        <Label
                                                fx:id="libelleRoleUtilisateur"
                                                styleClass="user-role"
                                                text="Rôle"/>

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                    </children>

                </HBox>

            </top>


            <center>

                <ScrollPane
                        fitToHeight="true"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="content-scroll">

                    <content>

                        <StackPane
                                fx:id="zoneContenu"
                                styleClass="content-area">

                        </StackPane>

                    </content>

                </ScrollPane>

            </center>

        </BorderPane>

    </center>

</BorderPane>