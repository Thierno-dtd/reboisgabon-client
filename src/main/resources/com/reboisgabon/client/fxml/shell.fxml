<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="fond-application"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.reboisgabon.client.controllers.ShellController">

    <left>
        <StackPane fx:id="conteneurBarreLaterale" prefWidth="248" minWidth="248" maxWidth="248" styleClass="barre-laterale">
            <VBox fx:id="decorBarreLaterale" alignment="BOTTOM_CENTER" mouseTransparent="true"/>
            <VBox spacing="0">
                <HBox fx:id="zoneMarque" alignment="CENTER_LEFT" spacing="11">
                    <padding>
                        <Insets top="20" right="16" bottom="14" left="18"/>
                    </padding>
                    <VBox spacing="1">
                        <Label text="ReboisGabon" styleClass="marque-nom"/>
                        <Label text="Pilotage du reboisement" styleClass="marque-sous-titre"/>
                    </VBox>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                    <VBox spacing="2">
                        <padding>
                            <Insets top="0" right="12" bottom="12" left="12"/>
                        </padding>

                        <Label text="PILOTAGE" styleClass="groupe-nav"/>
                        <Button fx:id="boutonDashboard" maxWidth="Infinity" onAction="#allerDashboard" styleClass="nav-button" text="Tableau de bord">
                            <graphic><FontIcon iconLiteral="mdi2v-view-dashboard-outline"/></graphic>
                        </Button>
                        <Button fx:id="boutonCarte" maxWidth="Infinity" onAction="#allerCarte" styleClass="nav-button" text="Carte du territoire">
                            <graphic><FontIcon iconLiteral="mdi2m-map-outline"/></graphic>
                        </Button>

                        <Label fx:id="groupeTerrain" text="TERRAIN" styleClass="groupe-nav"/>
                        <Button fx:id="boutonSites" maxWidth="Infinity" onAction="#allerSites" styleClass="nav-button" text="Sites de reboisement">
                            <graphic><FontIcon iconLiteral="mdi2m-map-marker-outline"/></graphic>
                        </Button>
                        <Button fx:id="boutonCampagnes" maxWidth="Infinity" onAction="#allerCampagnes" styleClass="nav-button" text="Campagnes de plantation">
                            <graphic><FontIcon iconLiteral="mdi2s-sprout-outline"/></graphic>
                        </Button>
                        <Button fx:id="boutonSuivis" maxWidth="Infinity" onAction="#allerSuivis" styleClass="nav-button" text="Suivis de croissance">
                            <graphic><FontIcon iconLiteral="mdi2c-clipboard-text-outline"/></graphic>
                        </Button>
                        <Button fx:id="boutonEssences" maxWidth="Infinity" onAction="#allerEssences" styleClass="nav-button" text="Essences">
                            <graphic><FontIcon iconLiteral="mdi2p-pine-tree"/></graphic>
                        </Button>

                        <Label fx:id="groupeProgramme" text="PROGRAMME" styleClass="groupe-nav"/>
                        <Button fx:id="boutonObjectifs" maxWidth="Infinity" onAction="#allerObjectifs" styleClass="nav-button" text="Objectifs">
                            <graphic><FontIcon iconLiteral="mdi2f-flag-outline"/></graphic>
                        </Button>
                        <Button fx:id="boutonFinances" maxWidth="Infinity" onAction="#allerFinances" styleClass="nav-button" text="Finances">
                            <graphic><FontIcon iconLiteral="mdi2b-bank-outline"/></graphic>
                        </Button>
                        <Button fx:id="boutonIntelligence" maxWidth="Infinity" onAction="#allerIntelligence" styleClass="nav-button" text="Intelligence écologique">
                            <graphic><FontIcon iconLiteral="mdi2f-flask-outline"/></graphic>
                        </Button>

                        <Label fx:id="groupeAdministration" text="ADMINISTRATION" styleClass="groupe-nav"/>
                        <Button fx:id="boutonUtilisateurs" maxWidth="Infinity" onAction="#allerUtilisateurs" styleClass="nav-button" text="Utilisateurs">
                            <graphic><FontIcon iconLiteral="mdi2a-account-group-outline"/></graphic>
                        </Button>
                        <Button fx:id="boutonJournal" maxWidth="Infinity" onAction="#allerJournal" styleClass="nav-button" text="Journal d'activité">
                            <graphic><FontIcon iconLiteral="mdi2h-history"/></graphic>
                        </Button>
                    </VBox>
                </ScrollPane>

                <VBox spacing="8">
                    <padding>
                        <Insets top="6" right="12" bottom="16" left="12"/>
                    </padding>
                    <Button fx:id="boutonParametres" maxWidth="Infinity" onAction="#allerParametres" styleClass="nav-button" text="Paramètres">
                        <graphic><FontIcon iconLiteral="mdi2c-cog-outline"/></graphic>
                    </Button>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="carte-utilisateur">
                        <Label fx:id="libelleInitiales" styleClass="avatar" text="RG"/>
                        <VBox spacing="1" HBox.hgrow="ALWAYS">
                            <Label fx:id="libelleNomUtilisateur" styleClass="user-name" text="Utilisateur"/>
                            <Label fx:id="libelleRoleUtilisateur" styleClass="user-role" text="Rôle"/>
                        </VBox>
                        <Button fx:id="boutonDeconnexion" onAction="#seDeconnecter" styleClass="bouton-deconnexion">
                            <graphic><FontIcon iconLiteral="mdi2l-logout-variant"/></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="barre-haute">
                    <padding>
                        <Insets top="10" right="24" bottom="10" left="28"/>
                    </padding>
                    <Label fx:id="libelleDate" styleClass="texte-muet" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Region prefWidth="4"/>
                    <StackPane>
                        <Button fx:id="boutonNotifications" onAction="#allerNotifications" styleClass="bouton-barre">
                            <graphic><FontIcon iconLiteral="mdi2b-bell-outline"/></graphic>
                        </Button>
                        <Label fx:id="badgeNotifications" styleClass="notification-badge" text="0" visible="false"
                               StackPane.alignment="TOP_RIGHT" mouseTransparent="true"/>
                    </StackPane>
                </HBox>
            </top>
            <center>
                <ScrollPane fx:id="defilementContenu" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
                    <StackPane fx:id="zoneContenu" styleClass="content-area"/>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
