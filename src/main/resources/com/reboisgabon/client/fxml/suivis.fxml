<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="entete-page">
        <StackPane styleClass="icone-page"><FontIcon iconLiteral="mdi2c-clipboard-text-outline"/></StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="titre-page" text="Suivis de croissance"/>
            <Label styleClass="sous-titre" text="Chaque contrôle de terrain mesure le taux de survie d'une campagne : c'est lui qui alimente la moyenne par site." wrapText="true"/>
        </VBox>
    </HBox>
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Contrôles effectués">
            <fx:include source="suivis-liste.fxml"/>
        </Tab>
        <Tab text="Calendrier des prochains contrôles">
            <fx:include source="calendrier-suivis.fxml"/>
        </Tab>
    </TabPane>
</VBox>
