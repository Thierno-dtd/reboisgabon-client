<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.journal.JournalController">
    <HBox spacing="12" styleClass="carte-verre">
        <padding>
            <Insets bottom="16" left="16" right="16" top="16"/>
        </padding>
        <TextField fx:id="champRecherche" promptText="Rechercher..." styleClass="champ-texte" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="comboAction" prefWidth="170" promptText="Action" styleClass="champ-texte"/>
        <TextField fx:id="champModele" prefWidth="130" promptText="Modèle" styleClass="champ-texte"/>
        <DatePicker fx:id="champDateDebut" prefWidth="140" promptText="Date début" styleClass="champ-texte"/>
        <DatePicker fx:id="champDateFin" prefWidth="140" promptText="Date fin" styleClass="champ-texte"/>
        <Button onAction="#rechercher" styleClass="bouton-primaire" text="Rechercher"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exporterCsv" styleClass="bouton-secondaire" text="Exporter CSV"/>
    </HBox>
    <VBox fx:id="conteneurTableau" VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="barre-pagination">
        <Button fx:id="boutonPrecedent" onAction="#pagePrecedente" styleClass="bouton-secondaire" text="Précédent"/>
        <Label fx:id="libelleInfoPagination" styleClass="texte-muet"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonSuivant" onAction="#pageSuivante" styleClass="bouton-secondaire" text="Suivant"/>
    </HBox>
</VBox>