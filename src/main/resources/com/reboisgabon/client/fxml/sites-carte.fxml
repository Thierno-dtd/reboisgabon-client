<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.sites.SitesCarteController">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="carte-verre">
        <padding>
            <Insets bottom="12" left="16" right="16" top="12"/>
        </padding>
        <Label text="Province :" styleClass="texte-muet"/>
        <Label fx:id="libelleProvinceActive" text="Toutes les provinces" styleClass="titre-2"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Réinitialiser la vue" onAction="#reinitialiserVueGabon" styleClass="bouton-secondaire"/>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <StackPane styleClass="carte-verre" HBox.hgrow="ALWAYS">
            <WebView fx:id="carte" prefHeight="460" />
        </StackPane>

        <VBox fx:id="panneauDetail" spacing="14" prefWidth="260" minWidth="260" styleClass="carte-verre" visible="false" managed="false">
            <padding>
                <Insets bottom="18" left="18" right="18" top="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="libelleTitrePanneau" text="Détail du site" styleClass="titre-2" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="boutonFermerDetail" text="✕" onAction="#masquerDetail" styleClass="bouton-icone"/>
            </HBox>

            <Label fx:id="libelleNomSite" text="—" styleClass="dashboard-stat-value" wrapText="true"/>
            <Label fx:id="badgeStatutSite" text="—" styleClass="badge-succes"/>

            <VBox spacing="10">
                <VBox spacing="2">
                    <Label text="Localité" styleClass="dashboard-detail-key"/>
                    <Label fx:id="libelleLocaliteSite" text="—" styleClass="dashboard-detail-value" wrapText="true"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="Province" styleClass="dashboard-detail-key"/>
                    <Label fx:id="libelleProvinceSite" text="—" styleClass="dashboard-detail-value" wrapText="true"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="Superficie" styleClass="dashboard-detail-key"/>
                    <Label fx:id="libelleSuperficieSite" text="—" styleClass="dashboard-detail-value"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="Responsable" styleClass="dashboard-detail-key"/>
                    <Label fx:id="libelleResponsableSite" text="—" styleClass="dashboard-detail-value" wrapText="true"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Taux de survie" styleClass="dashboard-detail-key"/>
                    <Label fx:id="libelleTauxSurvieSite" text="—" styleClass="dashboard-detail-value"/>
                    <ProgressBar fx:id="barreSurvieSite" progress="0" maxWidth="1.7976931348623157E308" styleClass="barre-progression"/>
                </VBox>
            </VBox>

            <Button text="Score écologique" onAction="#voirScoreSite" styleClass="bouton-primaire" maxWidth="1.7976931348623157E308"/>
        </VBox>
    </HBox>

    <VBox spacing="10" styleClass="carte-verre">
        <padding>
            <Insets bottom="16" left="16" right="16" top="16"/>
        </padding>
        <Label text="Sites à proximité" styleClass="titre-2"/>
        <HBox spacing="12">
            <TextField fx:id="champLatitude" prefWidth="150" promptText="Latitude" styleClass="champ-texte"/>
            <TextField fx:id="champLongitude" prefWidth="150" promptText="Longitude" styleClass="champ-texte"/>
            <TextField fx:id="champRayon" prefWidth="150" promptText="Rayon (km)" styleClass="champ-texte"/>
            <Button onAction="#rechercherProximite" styleClass="bouton-primaire" text="Rechercher"/>
        </HBox>
    </VBox>
    <ScrollPane fitToWidth="true" prefHeight="220" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="conteneurResultatsProximite" spacing="10"/>
    </ScrollPane>
</VBox>