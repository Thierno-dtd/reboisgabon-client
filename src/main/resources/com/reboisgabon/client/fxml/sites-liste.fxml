<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.sites.SitesListController">
    <HBox spacing="12" styleClass="carte-verre">
        <padding>
            <Insets bottom="16" left="16" right="16" top="16"/>
        </padding>
        <TextField fx:id="champRecherche" promptText="Rechercher..." styleClass="champ-texte" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="champProvince" prefWidth="160" promptText="Province" styleClass="champ-texte"/>
        <ComboBox fx:id="comboStatut" prefWidth="150" promptText="Statut" styleClass="champ-texte"/>
        <TextField fx:id="champTauxSurvieMin" prefWidth="140" promptText="Taux survie min" styleClass="champ-texte"/>
        <Button onAction="#rechercher" styleClass="bouton-primaire" text="Rechercher"/>
        <Button fx:id="boutonNouveauSite" onAction="#ouvrirCreation" styleClass="bouton-primaire" text="Nouveau site"/>
    </HBox>
    <TableView fx:id="tableSites" styleClass="table-generique" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneNom" prefWidth="160" text="Nom"/>
            <TableColumn fx:id="colonneLocalite" prefWidth="140" text="Localité"/>
            <TableColumn fx:id="colonneProvince" prefWidth="140" text="Province"/>
            <TableColumn fx:id="colonneSuperficie" prefWidth="120" text="Superficie (ha)"/>
            <TableColumn fx:id="colonneStatut" prefWidth="110" text="Statut"/>
            <TableColumn fx:id="colonneTauxSurvie" prefWidth="100" text="Taux survie"/>
            <TableColumn fx:id="colonneActions" prefWidth="180" text="Actions"/>
        </columns>
    </TableView>
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="barre-pagination">
        <Button fx:id="boutonPrecedent" onAction="#pagePrecedente" styleClass="bouton-secondaire" text="Précédent"/>
        <Label fx:id="libelleInfoPagination" styleClass="texte-muet"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonSuivant" onAction="#pageSuivante" styleClass="bouton-secondaire" text="Suivant"/>
    </HBox>
</VBox>