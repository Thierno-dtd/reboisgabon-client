<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.sites.SitesListController">
    <VBox fx:id="zoneEntete"/>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barre-filtres">
        <FontIcon iconLiteral="mdi2m-magnify" iconSize="18" iconColor="#66766A"/>
        <TextField fx:id="champRecherche" promptText="Rechercher un site, une localité…" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="comboProvince" prefWidth="170" promptText="Toutes les provinces"/>
        <ComboBox fx:id="comboStatut" prefWidth="150" promptText="Tous les statuts"/>
        <ComboBox fx:id="comboSurvie" prefWidth="160" promptText="Toute survie"/>
        <Button onAction="#reinitialiserFiltres" styleClass="bouton-lien" text="Effacer">
            <graphic><FontIcon iconLiteral="mdi2f-filter-variant"/></graphic>
        </Button>
    </HBox>
    <TableView fx:id="tableSites" VBox.vgrow="ALWAYS" minHeight="360">
        <columns>
            <TableColumn fx:id="colonneNom" prefWidth="260" text="SITE"/>
            <TableColumn fx:id="colonneProvince" prefWidth="140" text="PROVINCE"/>
            <TableColumn fx:id="colonneSuperficie" prefWidth="110" text="SUPERFICIE"/>
            <TableColumn fx:id="colonneCampagnes" prefWidth="100" text="CAMPAGNES"/>
            <TableColumn fx:id="colonneStatut" prefWidth="110" text="STATUT"/>
            <TableColumn fx:id="colonneTauxSurvie" prefWidth="170" text="SURVIE MOYENNE"/>
            <TableColumn fx:id="colonneActions" prefWidth="130" minWidth="120" sortable="false" text=""/>
        </columns>
    </TableView>
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="barre-pagination">
        <Label fx:id="libelleInfoPagination"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonPrecedent" onAction="#pagePrecedente" styleClass="bouton-secondaire" text="Précédent"/>
        <Button fx:id="boutonSuivant" onAction="#pageSuivante" styleClass="bouton-secondaire" text="Suivant"/>
    </HBox>
</VBox>
