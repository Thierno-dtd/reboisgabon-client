<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="fond-application" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.reboisgabon.client.controllers.objectifs.ObjectifFormController">
    <VBox maxWidth="500" spacing="14" styleClass="carte-verre">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30"/>
        </padding>
        <Label fx:id="libelleTitre" styleClass="titre-1" text="Nouvel objectif"/>
        <VBox spacing="6">
            <Label styleClass="texte-muet" text="Titre"/>
            <TextField fx:id="champTitre" styleClass="champ-texte"/>
        </VBox>
        <VBox spacing="6">
            <Label styleClass="texte-muet" text="Description"/>
            <TextArea fx:id="champDescription" prefRowCount="2" styleClass="zone-texte" wrapText="true"/>
        </VBox>
        <VBox spacing="6">
            <Label styleClass="texte-muet" text="Portée"/>
            <ComboBox fx:id="comboPortee" maxWidth="Infinity" onAction="#surChangementPortee" styleClass="champ-texte"/>
        </VBox>
        <VBox fx:id="conteneurProvince" spacing="6">
            <Label styleClass="texte-muet" text="Province"/>
            <TextField fx:id="champProvince" styleClass="champ-texte"/>
        </VBox>
        <VBox fx:id="conteneurSite" spacing="6">
            <Label styleClass="texte-muet" text="Site"/>
            <ComboBox fx:id="comboSite" maxWidth="Infinity" styleClass="champ-texte"/>
        </VBox>
        <HBox spacing="14">
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label styleClass="texte-muet" text="Plants cibles"/>
                <TextField fx:id="champPlantsCible" styleClass="champ-texte"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label styleClass="texte-muet" text="Taux survie visé (%)"/>
                <TextField fx:id="champTauxVise" styleClass="champ-texte"/>
            </VBox>
        </HBox>
        <HBox spacing="14">
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label styleClass="texte-muet" text="Date début"/>
                <DatePicker fx:id="champDateDebut" maxWidth="Infinity" styleClass="champ-texte"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label styleClass="texte-muet" text="Échéance"/>
                <DatePicker fx:id="champDateEcheance" maxWidth="Infinity" styleClass="champ-texte"/>
            </VBox>
        </HBox>
        <VBox spacing="6">
            <Label styleClass="texte-muet" text="Responsable"/>
            <ComboBox fx:id="comboResponsable" maxWidth="Infinity" styleClass="champ-texte"/>
        </VBox>
        <Label fx:id="libelleErreur" managed="false" styleClass="badge-erreur" visible="false" wrapText="true"/>
        <HBox spacing="12">
            <Button fx:id="boutonEnregistrer" maxWidth="Infinity" onAction="#enregistrer" styleClass="bouton-primaire" text="Enregistrer" HBox.hgrow="ALWAYS"/>
            <Button maxWidth="Infinity" onAction="#annuler" styleClass="bouton-secondaire" text="Annuler" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>
</StackPane>