<?xml version="1.0" encoding="UTF-8"?>

<?import com.reboisgabon.client.ui.PanneauVisuel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox styleClass="connexion-fond" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.MotDePasseOublieController">
    <PanneauVisuel HBox.hgrow="ALWAYS" prefWidth="720"/>
    <StackPane minWidth="460" prefWidth="560" maxWidth="620" HBox.hgrow="SOMETIMES">
        <VBox alignment="CENTER_LEFT" maxWidth="380" spacing="24">
            <StackPane styleClass="icone-page" maxWidth="-Infinity">
                <FontIcon iconLiteral="mdi2e-email-outline"/>
            </StackPane>
            <VBox spacing="6">
                <Label styleClass="titre-page" text="Mot de passe oublié"/>
                <Label styleClass="sous-titre" wrapText="true" text="Indiquez l'adresse e-mail de votre compte. Vous recevrez un code de réinitialisation valable une heure et utilisable une seule fois."/>
            </VBox>
            <VBox spacing="6">
                <Label styleClass="libelle-champ" text="Adresse e-mail"/>
                <TextField fx:id="champEmail" promptText="prenom.nom@reboisgabon.ga"/>
            </VBox>
            <Label fx:id="libelleMessage" managed="false" visible="false" wrapText="true" maxWidth="Infinity"/>
            <VBox spacing="10">
                <Button fx:id="boutonEnvoyer" defaultButton="true" maxWidth="Infinity" onAction="#envoyerDemande" styleClass="bouton-primaire" text="Recevoir le code">
                    <padding><Insets top="11" bottom="11"/></padding>
                </Button>
                <Button maxWidth="Infinity" onAction="#allerReinitialiser" styleClass="bouton-secondaire" text="J'ai déjà reçu un code"/>
                <Button maxWidth="Infinity" onAction="#retourLogin" styleClass="bouton-lien" text="Revenir à la connexion"/>
            </VBox>
        </VBox>
    </StackPane>
</HBox>
