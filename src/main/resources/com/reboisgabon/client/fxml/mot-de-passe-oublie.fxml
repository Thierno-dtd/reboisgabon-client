<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="fond-application" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml" fx:controller="com.reboisgabon.client.controllers.MotDePasseOublieController">
    <VBox alignment="CENTER" maxWidth="400" spacing="18" styleClass="carte-verre">
        <padding>
            <Insets bottom="44" left="40" right="40" top="44"/>
        </padding>
        <Label styleClass="titre-1" text="Mot de passe oublié"/>
        <Label styleClass="sous-titre" text="Un lien de réinitialisation vous sera envoyé par email" wrapText="true"/>
        <TextField fx:id="champEmail" promptText="votre@email.ga" styleClass="champ-texte"/>
        <Label fx:id="libelleMessage" managed="false" styleClass="texte-corps" visible="false" wrapText="true"/>
        <Button fx:id="boutonEnvoyer" maxWidth="Infinity" onAction="#envoyerDemande" styleClass="bouton-primaire" text="Envoyer"/>
        <Button maxWidth="Infinity" onAction="#allerReinitialiser" styleClass="bouton-secondaire" text="J'ai déjà un code"/>
        <Button maxWidth="Infinity" onAction="#retourLogin" styleClass="bouton-secondaire" text="Retour à la connexion"/>
    </VBox>
</StackPane>