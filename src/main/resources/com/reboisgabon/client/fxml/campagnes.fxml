<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.campagnes.CampagnesListController">
    <VBox fx:id="zoneEntete"/>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barre-filtres">
        <FontIcon iconLiteral="mdi2f-filter-variant" iconSize="18" iconColor="#66766A"/>
        <ComboBox fx:id="comboSite" prefWidth="230" promptText="Tous les sites" HBox.hgrow="ALWAYS" maxWidth="320"/>
        <ComboBox fx:id="comboEssence" prefWidth="170" promptText="Toutes les essences"/>
        <DatePicker fx:id="champDateDebut" prefWidth="140" promptText="Planté du"/>
        <DatePicker fx:id="champDateFin" prefWidth="140" promptText="au"/>
        <ComboBox fx:id="comboSurvie" prefWidth="150" promptText="Toute survie"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#reinitialiserFiltres" styleClass="bouton-lien" text="Effacer"/>
    </HBox>
    <TableView fx:id="tableCampagnes" VBox.vgrow="ALWAYS" minHeight="360">
        <columns>
            <TableColumn fx:id="colonneEssence" prefWidth="200" text="ESSENCE"/>
            <TableColumn fx:id="colonneSite" prefWidth="260" text="SITE"/>
            <TableColumn fx:id="colonneDatePlantation" prefWidth="130" text="PLANTATION"/>
            <TableColumn fx:id="colonneNombrePlants" prefWidth="110" text="PLANTS"/>
            <TableColumn fx:id="colonneTauxSurvie" prefWidth="170" text="SURVIE MOYENNE"/>
            <TableColumn fx:id="colonneActions" prefWidth="100" minWidth="90" sortable="false" text=""/>
        </columns>
    </TableView>
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="barre-pagination">
        <Label fx:id="libelleInfoPagination"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonPrecedent" onAction="#pagePrecedente" styleClass="bouton-secondaire" text="Précédent"/>
        <Button fx:id="boutonSuivant" onAction="#pageSuivante" styleClass="bouton-secondaire" text="Suivant"/>
    </HBox>
</VBox>
