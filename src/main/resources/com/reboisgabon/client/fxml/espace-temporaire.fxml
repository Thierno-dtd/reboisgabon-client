<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="fond-application" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml" fx:controller="com.reboisgabon.client.controllers.EspaceTemporaireController">
    <VBox alignment="CENTER" maxWidth="440" spacing="14" styleClass="carte-verre">
        <padding>
            <Insets bottom="44" left="40" right="40" top="44"/>
        </padding>
        <Label styleClass="titre-1" text="Connexion réussie"/>
        <Label fx:id="libelleUtilisateur" styleClass="titre-2"/>
        <Label fx:id="libelleRole" styleClass="sous-titre"/>
        <Label styleClass="texte-muet" text="Cet écran est temporaire — il sera remplacé par le shell principal au module 3." wrapText="true"/>
        <Button maxWidth="Infinity" onAction="#seDeconnecter" styleClass="bouton-secondaire" text="Se déconnecter"/>
    </VBox>
</StackPane>