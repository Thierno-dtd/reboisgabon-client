<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="fond-application" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.reboisgabon.client.controllers.utilisateurs.UtilisateurFormController">
    <VBox maxWidth="460" spacing="14" styleClass="carte-verre">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30"/>
        </padding>
        <Label fx:id="libelleTitre" styleClass="titre-1" text="Nouvel utilisateur"/>
        <VBox spacing="6">
            <Label styleClass="texte-muet" text="Email"/>
            <TextField fx:id="champEmail" styleClass="champ-texte"/>
        </VBox>
        <HBox spacing="14">
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label styleClass="texte-muet" text="Prénom"/>
                <TextField fx:id="champPrenom" styleClass="champ-texte"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label styleClass="texte-muet" text="Nom"/>
                <TextField fx:id="champNom" styleClass="champ-texte"/>
            </VBox>
        </HBox>
        <VBox spacing="6">
            <Label styleClass="texte-muet" text="Rôle"/>
            <ComboBox fx:id="comboRole" maxWidth="Infinity" styleClass="champ-texte"/>
        </VBox>
        <VBox fx:id="conteneurMotDePasse" spacing="6">
            <Label styleClass="texte-muet" text="Mot de passe (laisser vide pour générer automatiquement)"/>
            <PasswordField fx:id="champMotDePasse" styleClass="champ-texte"/>
        </VBox>
        <CheckBox fx:id="caseActif" selected="true" text="Compte actif"/>
        <Label fx:id="libelleErreur" managed="false" styleClass="badge-erreur" visible="false" wrapText="true"/>
        <HBox spacing="12">
            <Button fx:id="boutonEnregistrer" maxWidth="Infinity" onAction="#enregistrer" styleClass="bouton-primaire" text="Enregistrer" HBox.hgrow="ALWAYS"/>
            <Button maxWidth="Infinity" onAction="#annuler" styleClass="bouton-secondaire" text="Annuler" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>
</StackPane>