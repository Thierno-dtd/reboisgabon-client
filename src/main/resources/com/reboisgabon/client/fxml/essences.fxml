<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.essences.EssencesListController">
    <HBox spacing="12" styleClass="carte-verre">
        <padding>
            <Insets bottom="16" left="16" right="16" top="16"/>
        </padding>
        <TextField fx:id="champRecherche" promptText="Rechercher..." styleClass="champ-texte" HBox.hgrow="ALWAYS"/>
        <Button onAction="#rechercher" styleClass="bouton-primaire" text="Rechercher"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonNouvelleEssence" onAction="#ouvrirCreation" styleClass="bouton-primaire" text="Nouvelle essence"/>
    </HBox>
    <TableView fx:id="tableEssences" styleClass="table-generique" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneNom" prefWidth="180" text="Nom"/>
            <TableColumn fx:id="colonneNomScientifique" prefWidth="200" text="Nom scientifique"/>
            <TableColumn fx:id="colonneDescription" prefWidth="260" text="Description"/>
            <TableColumn fx:id="colonneActions" prefWidth="180" text="Actions"/>
        </columns>
    </TableView>
</VBox>