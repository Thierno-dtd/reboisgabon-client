<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.essences.EssencesListController">
    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="entete-page">
        <StackPane styleClass="icone-page"><FontIcon iconLiteral="mdi2p-pine-tree"/></StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="titre-page" text="Herbier des essences"/>
            <Label styleClass="sous-titre" text="Chaque espèce plantée, avec son nom scientifique et ce qu'elle donne sur le terrain." wrapText="true"/>
        </VBox>
        <Button fx:id="boutonNouvelleEssence" onAction="#ouvrirCreation" styleClass="bouton-primaire" text="Nouvelle essence">
            <graphic><FontIcon iconLiteral="mdi2p-plus"/></graphic>
        </Button>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barre-filtres">
        <FontIcon iconLiteral="mdi2m-magnify" iconSize="18" iconColor="#66766A"/>
        <TextField fx:id="champRecherche" promptText="Rechercher une essence ou un nom scientifique…" HBox.hgrow="ALWAYS"/>
        <Region prefWidth="8"/>
        <Label fx:id="libelleNombre" styleClass="texte-muet"/>
    </HBox>
    <FlowPane fx:id="planche" hgap="16" vgap="16"/>
</VBox>
