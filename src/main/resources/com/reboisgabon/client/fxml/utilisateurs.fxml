<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.utilisateurs.UtilisateursListController">
    <HBox spacing="12" styleClass="carte-verre">
        <padding>
            <Insets bottom="16" left="16" right="16" top="16"/>
        </padding>
        <TextField fx:id="champRecherche" promptText="Rechercher..." styleClass="champ-texte" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="comboRole" prefWidth="150" promptText="Rôle" styleClass="champ-texte"/>
        <ComboBox fx:id="comboActif" prefWidth="130" promptText="Statut" styleClass="champ-texte"/>
        <Button onAction="#rechercher" styleClass="bouton-primaire" text="Rechercher"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonNouvelUtilisateur" onAction="#ouvrirCreation" styleClass="bouton-primaire" text="Nouvel utilisateur"/>
    </HBox>
    <TableView fx:id="tableUtilisateurs" styleClass="table-generique" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneEmail" prefWidth="220" text="Email"/>
            <TableColumn fx:id="colonnePrenom" prefWidth="130" text="Prénom"/>
            <TableColumn fx:id="colonneNom" prefWidth="130" text="Nom"/>
            <TableColumn fx:id="colonneRole" prefWidth="120" text="Rôle"/>
            <TableColumn fx:id="colonneActif" prefWidth="80" text="Actif"/>
            <TableColumn fx:id="colonneActions" prefWidth="220" text="Actions"/>
        </columns>
    </TableView>
</VBox>