<?xml version="1.0" encoding="UTF-8"?>

<?import com.reboisgabon.client.ui.PanneauVisuel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox styleClass="connexion-fond" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.Verification2faController">
    <PanneauVisuel HBox.hgrow="ALWAYS" prefWidth="720"/>
    <StackPane minWidth="460" prefWidth="560" maxWidth="620" HBox.hgrow="SOMETIMES">
        <VBox alignment="CENTER_LEFT" maxWidth="380" spacing="24">
            <StackPane styleClass="icone-page" maxWidth="-Infinity">
                <FontIcon iconLiteral="mdi2s-shield-lock-outline"/>
            </StackPane>
            <VBox spacing="6">
                <Label styleClass="titre-page" text="Vérification en deux étapes"/>
                <Label styleClass="sous-titre" wrapText="true" text="Ouvrez votre application d'authentification et saisissez le code à 6 chiffres affiché pour ReboisGabon."/>
            </VBox>
            <VBox spacing="6">
                <Label styleClass="libelle-champ" text="Code de vérification"/>
                <TextField fx:id="champCode" promptText="000000" styleClass="code-otp"/>
                <Label styleClass="texte-petit" text="Le code change toutes les 30 secondes."/>
            </VBox>
            <Label fx:id="libelleErreur" managed="false" styleClass="message-erreur" visible="false" wrapText="true" maxWidth="Infinity"/>
            <VBox spacing="10">
                <Button fx:id="boutonValider" defaultButton="true" maxWidth="Infinity" onAction="#validerCode" styleClass="bouton-primaire" text="Vérifier et se connecter">
                    <padding><Insets top="11" bottom="11"/></padding>
                </Button>
                <Button maxWidth="Infinity" onAction="#retourLogin" styleClass="bouton-lien" text="Revenir à la connexion"/>
            </VBox>
        </VBox>
    </StackPane>
</HBox>
