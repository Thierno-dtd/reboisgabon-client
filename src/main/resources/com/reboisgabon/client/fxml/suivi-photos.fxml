<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="fond-application" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.reboisgabon.client.controllers.suivis.SuiviPhotosController">
    <VBox maxWidth="640" spacing="16" styleClass="carte-verre">
        <padding>
            <Insets bottom="26" left="26" right="26" top="26"/>
        </padding>
        <Label styleClass="titre-1" text="Photos du suivi"/>
        <HBox spacing="10">
            <Button onAction="#choisirFichier" styleClass="bouton-secondaire" text="Choisir une image"/>
            <Label fx:id="libelleFichierSelectionne" styleClass="texte-muet"/>
        </HBox>
        <HBox spacing="10">
            <TextField fx:id="champLegende" HBox.hgrow="ALWAYS" promptText="Légende (optionnel)" styleClass="champ-texte"/>
            <Button fx:id="boutonEnvoyer" onAction="#envoyerPhoto" styleClass="bouton-primaire" text="Envoyer"/>
        </HBox>
        <Label fx:id="libelleErreur" managed="false" styleClass="badge-erreur" visible="false" wrapText="true"/>
        <ScrollPane fitToWidth="true" prefHeight="360" style="-fx-background-color: transparent;">
            <FlowPane fx:id="grillePhotos" hgap="14" vgap="14"/>
        </ScrollPane>
        <Button maxWidth="Infinity" onAction="#fermer" styleClass="bouton-secondaire" text="Fermer"/>
    </VBox>
</StackPane>