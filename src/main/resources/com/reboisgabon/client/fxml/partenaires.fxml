<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.finances.PartenairesListController">
    <HBox spacing="12" styleClass="carte-verre">
        <padding>
            <Insets bottom="16" left="16" right="16" top="16"/>
        </padding>
        <TextField fx:id="champRecherche" promptText="Rechercher..." styleClass="champ-texte" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="comboType" prefWidth="160" promptText="Type" styleClass="champ-texte"/>
        <Button onAction="#rechercher" styleClass="bouton-primaire" text="Rechercher"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonNouveauPartenaire" onAction="#ouvrirCreation" styleClass="bouton-primaire" text="Nouveau partenaire"/>
    </HBox>
    <TableView fx:id="tablePartenaires" styleClass="table-generique" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneNom" prefWidth="200" text="Nom"/>
            <TableColumn fx:id="colonneType" prefWidth="150" text="Type"/>
            <TableColumn fx:id="colonnePays" prefWidth="150" text="Pays"/>
            <TableColumn fx:id="colonneActif" prefWidth="80" text="Actif"/>
            <TableColumn fx:id="colonneActions" prefWidth="120" text="Actions"/>
        </columns>
    </TableView>
</VBox>