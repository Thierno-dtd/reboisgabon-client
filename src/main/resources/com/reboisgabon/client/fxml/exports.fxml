<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="560" spacing="14" styleClass="carte-verre" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.exports.ExportsController">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30"/>
    </padding>
    <Label styleClass="titre-1" text="Exports"/>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="texte-corps" text="Rapport de synthèse (PDF)"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exporterRapportSynthese" styleClass="bouton-primaire" text="Télécharger"/>
    </HBox>
    <HBox fx:id="ligneRapportFinancier" alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="texte-corps" text="Rapport financier (PDF)"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exporterRapportFinancier" styleClass="bouton-primaire" text="Télécharger"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="texte-corps" text="Sites (Excel)"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exporterSites" styleClass="bouton-primaire" text="Télécharger"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="texte-corps" text="Campagnes (Excel)"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exporterCampagnes" styleClass="bouton-primaire" text="Télécharger"/>
    </HBox>
    <HBox fx:id="ligneFinancements" alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="texte-corps" text="Financements (Excel)"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#exporterFinancements" styleClass="bouton-primaire" text="Télécharger"/>
    </HBox>
</VBox>