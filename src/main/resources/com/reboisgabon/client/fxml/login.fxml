<?xml version="1.0" encoding="UTF-8"?>

<?import com.reboisgabon.client.ui.PanneauVisuel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox fx:id="racine" prefHeight="800.0" prefWidth="1280.0" styleClass="connexion-fond"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.reboisgabon.client.controllers.LoginController">

    <PanneauVisuel HBox.hgrow="ALWAYS" prefWidth="720"/>

    <StackPane minWidth="460" prefWidth="560" maxWidth="620" HBox.hgrow="SOMETIMES">
        <VBox alignment="CENTER_LEFT" maxWidth="380" spacing="26" styleClass="formulaire-connexion">
            <VBox spacing="6">
                <Label styleClass="titre-page" text="Connexion"/>
                <Label styleClass="sous-titre" wrapText="true" text="Identifiez-vous avec le compte créé par votre administrateur."/>
            </VBox>

            <VBox spacing="16">
                <VBox spacing="6">
                    <Label styleClass="libelle-champ" text="Adresse e-mail"/>
                    <TextField fx:id="emailField" promptText="prenom.nom@reboisgabon.ga"/>
                </VBox>

                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="libelle-champ" text="Mot de passe"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Hyperlink fx:id="lienMotDePasseOublie" onAction="#motDePasseOublie" text="Mot de passe oublié ?"/>
                    </HBox>
                    <StackPane alignment="CENTER_RIGHT">
                        <PasswordField fx:id="passwordField" promptText="Votre mot de passe"/>
                        <TextField fx:id="passwordTextField" managed="false" promptText="Votre mot de passe" visible="false"/>
                        <Button fx:id="togglePasswordBtn" onAction="#handleTogglePassword" styleClass="bouton-oeil">
                            <graphic><FontIcon iconLiteral="mdi2e-eye-outline"/></graphic>
                        </Button>
                    </StackPane>
                </VBox>

                <Label fx:id="errorLabel" managed="false" styleClass="message-erreur" visible="false" wrapText="true" maxWidth="Infinity"/>

                <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" onAction="#handleLogin" styleClass="bouton-primaire" text="Se connecter">
                    <padding><Insets top="11" bottom="11"/></padding>
                </Button>
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="message-info">
                <FontIcon iconLiteral="mdi2s-shield-lock-outline" iconSize="20" iconColor="#2E6A9E"/>
                <Label styleClass="texte-petit" wrapText="true" HBox.hgrow="ALWAYS" style="-fx-text-fill: #2E6A9E;"
                       text="Si la double authentification est activée sur votre compte, un code à 6 chiffres vous sera demandé."/>
            </HBox>
        </VBox>
    </StackPane>
</HBox>
