<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="fond-application" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.reboisgabon.client.controllers.finances.FinancementFormController">
    <VBox maxWidth="480" spacing="14" styleClass="carte-verre">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30"/>
        </padding>
        <Label styleClass="titre-1" text="Nouveau financement"/>
        <VBox spacing="6">
            <Label styleClass="texte-muet" text="Partenaire"/>
            <ComboBox fx:id="comboPartenaire" maxWidth="Infinity" styleClass="champ-texte"/>
        </VBox>
        <HBox spacing="20">
            <RadioButton fx:id="radioCampagne" onAction="#surChangementCible" selected="true" text="Cibler une campagne">
                <toggleGroup>
                    <ToggleGroup fx:id="groupeCible"/>
                </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="radioSite" onAction="#surChangementCible" text="Cibler un site" toggleGroup="$groupeCible"/>
        </HBox>
        <ComboBox fx:id="comboCampagne" maxWidth="Infinity" styleClass="champ-texte"/>
        <ComboBox fx:id="comboSite" maxWidth="Infinity" managed="false" styleClass="champ-texte" visible="false"/>
        <HBox spacing="14">
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label styleClass="texte-muet" text="Montant"/>
                <TextField fx:id="champMontant" styleClass="champ-texte"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <Label styleClass="texte-muet" text="Devise"/>
                <ComboBox fx:id="comboDevise" maxWidth="Infinity" styleClass="champ-texte"/>
            </VBox>
        </HBox>
        <VBox spacing="6">
            <Label styleClass="texte-muet" text="Date"/>
            <DatePicker fx:id="champDate" maxWidth="Infinity" styleClass="champ-texte"/>
        </VBox>
        <Label fx:id="libelleErreur" managed="false" styleClass="badge-erreur" visible="false" wrapText="true"/>
        <HBox spacing="12">
            <Button fx:id="boutonEnregistrer" maxWidth="Infinity" onAction="#enregistrer" styleClass="bouton-primaire" text="Enregistrer" HBox.hgrow="ALWAYS"/>
            <Button maxWidth="Infinity" onAction="#annuler" styleClass="bouton-secondaire" text="Annuler" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>
</StackPane>