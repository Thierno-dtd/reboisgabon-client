<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.Label?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.objectifs.ObjectifsListController">
    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="entete-page">
        <StackPane styleClass="icone-page"><FontIcon iconLiteral="mdi2f-flag-outline"/></StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="titre-page" text="Objectifs de reboisement"/>
            <Label styleClass="sous-titre" text="Cibles nationales, provinciales ou par site, suivies automatiquement à partir des campagnes." wrapText="true"/>
        </VBox>
        <Button fx:id="boutonNouvelObjectif" onAction="#ouvrirCreation" styleClass="bouton-primaire" text="Nouvel objectif">
            <graphic><FontIcon iconLiteral="mdi2p-plus"/></graphic>
        </Button>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barre-filtres">
        <FontIcon iconLiteral="mdi2f-filter-variant" iconSize="18" iconColor="#66766A"/>
        <ComboBox fx:id="comboPortee" prefWidth="150" promptText="Portée"/>
    </HBox>
    <TableView fx:id="tableObjectifs" minHeight="340" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneTitre" prefWidth="330" text="TITRE"/>
            <TableColumn fx:id="colonnePortee" prefWidth="100" text="PORTÉE"/>
            <TableColumn fx:id="colonneEcheance" prefWidth="110" text="ÉCHÉANCE"/>
            <TableColumn fx:id="colonneProgression" prefWidth="190" text="PROGRESSION"/>
            <TableColumn fx:id="colonneStatut" prefWidth="120" text="STATUT"/>
            <TableColumn fx:id="colonneActions" prefWidth="90" minWidth="90" sortable="false" text=""/>
        </columns>
    </TableView>
</VBox>