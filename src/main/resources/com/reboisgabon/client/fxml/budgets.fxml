<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.finances.BudgetsListController">
    <HBox spacing="12" styleClass="carte-verre">
        <padding>
            <Insets bottom="16" left="16" right="16" top="16"/>
        </padding>
        <ComboBox fx:id="comboCampagne" prefWidth="220" promptText="Campagne" styleClass="champ-texte"/>
        <Button onAction="#rechercher" styleClass="bouton-primaire" text="Rechercher"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonNouveauBudget" onAction="#ouvrirCreation" styleClass="bouton-primaire" text="Nouveau budget"/>
    </HBox>
    <TableView fx:id="tableBudgets" styleClass="table-generique" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneCampagne" prefWidth="260" text="Campagne"/>
            <TableColumn fx:id="colonneMontantAlloue" prefWidth="140" text="Montant alloué"/>
            <TableColumn fx:id="colonneMontantReel" prefWidth="140" text="Montant réel"/>
        </columns>
    </TableView>
</VBox>