<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.Label?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.reboisgabon.client.controllers.finances.BudgetsListController">
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barre-filtres">
        <FontIcon iconLiteral="mdi2f-filter-variant" iconSize="18" iconColor="#66766A"/>
        <ComboBox fx:id="comboCampagne" prefWidth="220" promptText="Campagne"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="boutonNouveauBudget" onAction="#ouvrirCreation" styleClass="bouton-primaire" text="Nouveau budget">
            <graphic><FontIcon iconLiteral="mdi2p-plus"/></graphic>
        </Button>
    </HBox>
    <TableView fx:id="tableBudgets" minHeight="340" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneCampagne" prefWidth="260" text="CAMPAGNE"/>
            <TableColumn fx:id="colonneMontantAlloue" prefWidth="140" text="MONTANT ALLOUÉ"/>
            <TableColumn fx:id="colonneMontantReel" prefWidth="140" text="MONTANT RÉEL"/>
        </columns>
    </TableView>
</VBox>